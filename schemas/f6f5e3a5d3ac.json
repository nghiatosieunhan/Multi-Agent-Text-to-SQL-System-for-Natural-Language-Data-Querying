  "descriptions": {
    "event": "Lưu trữ thông tin về các sự kiện, bao gồm tên, ngày, loại, địa điểm và trạng thái.",
    "major": "Lưu trữ thông tin về các chuyên ngành học, bao gồm tên chuyên ngành, khoa và trường đại học.",
    "zip_code": "Lưu trữ thông tin về mã bưu chính, bao gồm thành phố, quận, tiểu bang và loại mã bưu chính.",
    "attendance": "Ghi lại sự tham dự của thành viên vào các sự kiện, liên kết thành viên với sự kiện.",
    "budget": "Quản lý ngân sách cho các sự kiện, bao gồm danh mục, số tiền đã chi, còn lại và tổng số tiền.",
    "expense": "Ghi lại các khoản chi tiêu, bao gồm mô tả, ngày, chi phí, trạng thái phê duyệt và liên kết đến thành viên và ngân sách.",
    "income": "Ghi lại các khoản thu nhập, bao gồm ngày nhận, số tiền, nguồn và ghi chú.",
    "member": "Lưu trữ thông tin chi tiết về các thành viên, bao gồm tên, email, chức vụ, thông tin liên hệ và chuyên ngành."
  }
