GEMINI_API_KEY=your_gemini_api_key_here

# Provider and models
LLM_PROVIDER=google
LLM_MODEL_FLASH=gemini-2.5-flash
LLM_MODEL_PRO=gemini-2.5-pro
EMBEDDING_MODEL=gemini-embedding-001

# Default database and indexes
DB_PATH=data/northwind/northwind.sqlite
FAISS_PERSIST_DIR=faiss_unified_fewshot_db
CHROMA_PERSIST_DIR=chroma_db

# Semantic cache safeguards
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_JACCARD_THRESHOLD=0.65
CACHE_MAX_SIZE=500

# Logging
LOG_LEVEL=INFO
DEBUG=false
