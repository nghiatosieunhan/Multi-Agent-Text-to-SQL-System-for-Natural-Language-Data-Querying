# Evaluated provider: Google Cloud Vertex AI
LLM_PROVIDER=google
LLM_MODEL_PRO=gemini-2.5-pro
LLM_MODEL_FLASH=gemini-2.5-pro
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Optional Groq generation provider. Vertex AI is still preferred for embeddings.
# LLM_PROVIDER=groq
# LLM_MODEL_PRO=llama-3.3-70b-versatile
# LLM_MODEL_FLASH=llama-3.3-70b-versatile
# GROQ_API_KEY=your-groq-api-key

DB_PATH=data/Chinook_VN.sqlite
FAISS_PERSIST_DIR=faiss_unified_fewshot_db
CHROMA_PERSIST_DIR=chroma_db
EMBEDDING_MODEL=gemini-embedding-001
LOG_LEVEL=INFO
DEBUG=false
